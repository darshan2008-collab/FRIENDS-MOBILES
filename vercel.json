{
  "version": 2,
  "name": "friends-mobiles-rho",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "alias": [
    "friends-mobiles-rho.vercel.app"
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}


